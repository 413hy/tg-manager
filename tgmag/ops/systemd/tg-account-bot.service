[Unit]
Description=Telegram Account Management Bot
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/tg-account-bot
EnvironmentFile=/opt/tg-account-bot/.env
ExecStart=/opt/tg-account-bot/.venv/bin/python -m app.main
Restart=always
RestartSec=5
User=tg-account-bot
Group=tg-account-bot

[Install]
WantedBy=multi-user.target

